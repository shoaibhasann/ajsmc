    "indexnow": "curl -sS \"https://ajsmc.in/api/indexnow\" | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>console.log(JSON.stringify(JSON.parse(s),null,2)))\"",
    "indexnow:all": "curl -sS \"https://ajsmc.in/api/indexnow?all=1\" | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>console.log(JSON.stringify(JSON.parse(s),null,2)))\"",
    "indexnow:dry": "curl -sS \"https://ajsmc.in/api/indexnow?dry=1\" | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>console.log(JSON.stringify(JSON.parse(s),null,2)))\""
  },
